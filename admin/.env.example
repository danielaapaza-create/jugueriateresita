# Copia este archivo como admin/.env.local
# Estos dos valores son PÚBLICOS (van dentro de la página web). La seguridad la
# dan Supabase Auth + las políticas RLS. NUNCA pongas aquí la service role key
# ni el token de WhatsApp.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
