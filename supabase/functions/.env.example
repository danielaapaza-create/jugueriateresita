# Copia este archivo como supabase/functions/.env (NO lo subas a GitHub).
# Se carga con:  supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY NO van aquí:
# Supabase los inyecta automáticamente en todas las Edge Functions.

# Token PERMANENTE de un usuario del sistema (no el temporal de 24 h).
WHATSAPP_TOKEN=
# "Identificador del número de teléfono" (no es el número en sí).
WHATSAPP_PHONE_NUMBER_ID=
# Texto largo y aleatorio inventado por ti; se repite en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app (Configuración de la app > Básica > Clave secreta).
WHATSAPP_APP_SECRET=

# Opcionales
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_TEMPLATE_ORDER_UPDATE=actualizacion_pedido
# WHATSAPP_TEMPLATE_LANGUAGE=es
# ADMIN_PANEL_ORIGIN=https://tu-usuario.github.io
